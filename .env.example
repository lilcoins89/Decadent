# ==============================================================================
# Trust Wallet Agent Terminal - Environment Configuration
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI Trading Agent reasoning and tool calling.
# Automatically injected at runtime in AI Studio from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (Cloud Run service URL).
# Automatically injected at runtime by AI Studio.
APP_URL="MY_APP_URL"

# PORT: Server listening port (default: 3000)
PORT=3000

# Optional Trust Wallet Developer Portal Configuration (portal.trustwallet.com)
# Configurable also within the app UI via the "Portal API" modal.
# TRUST_WALLET_PORTAL_API_KEY="tw_live_..."
# TRUST_WALLET_HMAC_SECRET="hmac_sec_..."

